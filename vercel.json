{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/py/:path*",
      "destination": "api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "excludeFiles": "{tests/**,results/**,*.md,*.pt}"
    }
  }
}

